# --- Agent ---
# Claude model: opus | sonnet | haiku  (or a full model id)
HYQS_MODEL=sonnet

# Permission mode for the agent's built-in tools (file/shell/web).
#   default            - asks (will hang headless; do not use 24/7)
#   acceptEdits        - auto-accepts file edits, asks for the rest
#   bypassPermissions  - runs everything unattended (powerful + risky)
HYQS_PERMISSION_MODE=acceptEdits

# Log output format for every process (hyqs / hyqs-pipeline / hyqs-web):
#   json     - one structured JSON line per log record (default; shippable/queryable)
#   console  - human-readable, for local dev
HYQS_LOG_FORMAT=json

# Where Hyqs keeps its chat memory (sqlite) AND the pipeline's git worktrees.
# MUST live OUTSIDE the repo: worktrees nested in the checkout let a build agent
# escape its worktree back into the parent repo (the isolation bug fixed by
# Job #41, whose startup guard refuses to boot if data_dir is inside a git repo).
HYQS_DATA_DIR=~/.hyqs/data

# Shared Postgres for the build pipeline — the multi-host coordination plane.
# Every host's `hyqs-pipeline` worker + the web console connect here. Bring one
# up with:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d
# (DATABASE_URL is accepted as a fallback.) Required to run the pipeline.
# The password below must match POSTGRES_PASSWORD.
HYQS_DB_URL=postgresql://hyqs:CHANGE_ME@localhost:5432/hyqs

# DSN the TEST SUITE uses to provision its isolated per-run databases.
# Required for pipeline jobs whose tests touch Postgres: a job runs its tests in
# a git worktree, .env is gitignored so the worktree has none, and HYQS_DB_URL is
# deliberately NOT passed into job subprocesses (it owns the shared control
# plane). Without this, tests/conftest.py falls back to a placeholder DSN and
# every DB-backed test fails to authenticate — which the gate then blames on the
# job's own diff. Point it at a role that may CREATE DATABASE on the same
# cluster; it is used only to create and drop <db>_test_<pid>_<uuid> databases.
HYQS_TEST_DB_ADMIN_URL=

# Password for the bundled Postgres container. REQUIRED — deploy/docker-compose.yml
# reads it from here and refuses to start without it, so the secret is never
# baked into a committed file. Generate one with `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Auth: by default the SDK uses your logged-in `claude` CLI subscription.
# To use an API key instead, set ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=

# --- Build pipeline (/build) ---
# Default target git repo for `/build <idea>` jobs (absolute path).
# Required for /build to work; leave empty to disable the default.
HYQS_DEFAULT_REPO=

# Model used for pipeline stages (plan/build/review). Falls back to HYQS_MODEL
# when empty. Use a stronger model here if you want better autonomous builds.
HYQS_PIPELINE_MODEL=

# Push to origin after a successful merge. Off by default (local merges only).
#   1 | true | yes | on  -> push
HYQS_GIT_PUSH=

# Autonomy: how many fix→retest→re-review rounds before a job gives up.
HYQS_PIPELINE_MAX_ATTEMPTS=3
# Hard cap (seconds) on a single AI stage, so a hung agent can't stall forever.
HYQS_PIPELINE_STAGE_TIMEOUT=1800
# When rate-limited without a known reset time, pause this many seconds.
HYQS_PIPELINE_LIMIT_BACKOFF=600

# Manual/operator drain (sent via SIGUSR1): stop claiming new jobs and give
# in-flight stages this many seconds to finish before force-cancelling them.
HYQS_PIPELINE_DRAIN_TIMEOUT=300
# Deploy-driven drain: the FIRST SIGTERM a worker receives (e.g. from
# `systemctl stop`/restart during a self-deploy) triggers this long ceiling
# instead, so a mid-flight 30-min build/fix stage survives an overlapping-
# fleet release. A second SIGTERM forces an immediate stop.
HYQS_PIPELINE_DEPLOY_DRAIN_TIMEOUT=2400

# Set to 1 to NOT run the pipeline inside the main `hyqs` daemon — use this when
# you run the pipeline as separate `hyqs-pipeline` process(es). Multiple workers
# are safe now (they coordinate through pipeline.db), so this is operational
# preference, not a correctness requirement.
HYQS_PIPELINE_DISABLED=

# --- Multi-worker (parallel builds) ---
# How many jobs ONE process runs at once (stages are async I/O, so they overlap).
# Run several `hyqs-pipeline` processes too; both compose. Actual parallelism is
# also capped per project by its agent roster (configured in the web UI).
HYQS_PIPELINE_CONCURRENCY=1
# A worker renews this lease (seconds) while a stage runs; if it dies, another
# worker reclaims the job after the lease expires.
HYQS_PIPELINE_LEASE_TTL=90
# Safety net (seconds) for a crashed worker holding a repo's merge lock.
HYQS_PIPELINE_MERGE_LOCK_TTL=300
# Safety net (seconds) for a crashed worker holding the schema-migration lock.
HYQS_PIPELINE_SCHEMA_LOCK_TTL=300
# How many stage timeouts a single job may burn before it is failed outright,
# instead of being reclaimed forever by the next worker.
HYQS_PIPELINE_MAX_TIMEOUTS=3
# A job with no progress for this many hours is treated as stale by the janitor.
HYQS_PIPELINE_JOB_STALE_HOURS=6

# --- Auto-deploy (optional) ---
# Poll origin/<base> for each project and file a deploy job when it advances.
#   1 | true | yes | on  -> enabled
HYQS_AUTO_DEPLOY=
# Seconds between polls.
HYQS_AUTO_DEPLOY_INTERVAL=120
# Give up after this many failed deploy attempts at the SAME commit, so a
# crash-looping app cannot churn out an unbounded queue of identical jobs.
# A new commit resets the counter.
HYQS_AUTO_DEPLOY_MAX_ATTEMPTS=3
# Shell command run to deploy this repo itself (self-deploy). Leave empty to
# use the built-in release path (deploy/release.sh).
HYQS_DEPLOY_CMD=

# --- Incident analyst (optional) ---
# An AI pass that diagnoses repeatedly-failing jobs and files fix jobs.
HYQS_PIPELINE_INCIDENT_ANALYST_PROVIDER=
HYQS_PIPELINE_INCIDENT_ANALYST_MODEL=
# Max fix jobs one diagnosis may file.
HYQS_PIPELINE_INCIDENT_ANALYST_JOB_CAP=
# Max failed jobs scanned per pass.
HYQS_PIPELINE_INCIDENT_ANALYST_SCAN_BUDGET=
# Set to 1 to skip the analyst pass before a job is dead-lettered.
HYQS_PIPELINE_INCIDENT_ANALYST_PREDEADLETTER_DISABLED=

# --- Codex provider (optional second agent) ---
# Agents can run on Codex instead of Claude (set per-project in the web UI).
# Requires the Codex CLI installed and authenticated.
HYQS_CODEX_BIN=codex
HYQS_CODEX_MODEL=
# Override the CLI args (default: "exec --full-auto").
HYQS_CODEX_ARGS=

# Where "new project" provisioning creates fresh repos (one subdir per project).
HYQS_PROJECTS_DIR=~/projects

# GitHub org to create new project repos under, instead of the authenticated
# gh account's personal namespace. Empty preserves today's behavior. The
# authenticated `gh` account must have permission to create repositories in
# this org; an org with restricted repo creation will reject the request.
HYQS_GITHUB_ORG=

# Domains that per-project nginx vhosts are served under. Comma-separated; each
# entry is `domain` or `domain=snippet.conf`. Without an explicit snippet the
# name is derived from the domain's first label (example.com -> example-ssl.conf),
# matching the certbot snippets deploy/ sets up. The FIRST entry is the base
# domain, so a project with slug `acme` is served at acme.<first-domain>.
#
# This is also the allowlist: a domain not listed here can never be written into
# a generated nginx config. Unset means no vhost can be rendered — vhost
# registration fails closed rather than guessing a hostname.
HYQS_NGINX_DOMAINS=

# --- Generated marketing site (docs/site/build.py) ---
# Byline printed in the footer and the author meta tag of the generated
# /how-it-works pages. All three are optional and omitted when empty, so a fork
# publishes the site without inheriting someone else's identity.
HYQS_SITE_AUTHOR=
HYQS_SITE_EMAIL=
HYQS_SITE_LINKEDIN=

# Path to the MaxMind-format (DB-IP City Lite) GeoIP database. Populate it
# with `bash scripts/fetch_geoip_db.sh`. Defaults to
# <HYQS_DATA_DIR>/geoip/dbip-city-lite.mmdb when unset. See deploy/README.md
# for the DB-IP CC BY 4.0 attribution requirement.
HYQS_GEOIP_DB=

# --- Web UI ---
# The web console/API binds here. Set HYQS_WEB_DISABLED=1 to run chat-only.
HYQS_WEB_HOST=0.0.0.0
HYQS_WEB_PORT=8787
HYQS_WEB_DISABLED=
# Bearer token guarding /api/* (and ?token= for the SSE stream). Strongly
# recommended if the port is reachable beyond localhost. Empty = no auth.
HYQS_WEB_TOKEN=

# Public base URL of the web console (e.g. https://hyqs.example.com), used to
# build outbound links such as the "View job" link in Slack job notifications.
# Must be provisioned for those links to appear — left empty, they're omitted
# rather than pointing at a broken/unset host.
HYQS_WEB_BASE_URL=

# --- First administrator (bootstrap) ---
# On startup, if the users table is EMPTY, these create the first platform
# admin. Without them a fresh install has no way to sign in. They are read only
# while no user exists, so they are inert once the account is created — but
# clear them from .env afterwards anyway rather than leaving a password on disk.
HYQS_ADMIN_EMAIL=
HYQS_ADMIN_PASSWORD=

# --- Google / Apple sign-in (optional) ---
# Sign-in is invite-only either way: OAuth never auto-provisions an account, it
# only matches an existing user or a pending invitation by email address.
# Google: create a Web-application OAuth client and register the redirect URI
#   <HYQS_WEB_BASE_URL>/api/auth/oauth/google/callback
# (and <HYQS_WEB_BASE_URL>/mcp/auth/callback if you use the MCP endpoint).
HYQS_GOOGLE_CLIENT_ID=
HYQS_GOOGLE_CLIENT_SECRET=
# Apple "Sign in with Apple": all four are required together.
HYQS_APPLE_CLIENT_ID=
HYQS_APPLE_TEAM_ID=
HYQS_APPLE_KEY_ID=
HYQS_APPLE_PRIVATE_KEY=

# --- Encryption key for stored third-party credentials ---
# Fernet key encrypting per-project secrets at rest (e.g. Slack bot tokens).
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP IT STABLE AND BACK IT UP: losing it permanently strands every credential
# already encrypted with it — they cannot be recovered, only re-entered.
HYQS_CREDENTIAL_ENCRYPTION_KEY=

# --- Container registry (Zot, Epic 81 multi-environment deployment) ---
# Bring it up with `docker compose --env-file .env -f deploy/docker-compose.registry.yml up -d`.
# Absolute path OUTSIDE the repo (same convention as HYQS_DATA_DIR) — registry
# blobs are never committed. Required for the compose service to start.
HYQS_REGISTRY_DATA_DIR=
# htpasswd file (bcrypt) holding both the push and pull credential classes.
# Required for the compose service to start. See deploy/README.md.
HYQS_REGISTRY_HTPASSWD=
# Loopback-only port nginx proxies to (deploy/setup-nginx-registry.sh).
HYQS_REGISTRY_PORT=5100

# Push/sign credentials for hyqs/pipeline/registry_push.py. BUILD-HOST-ONLY:
# these carry a push credential and a cosign signing key, so they must never
# be set on a deploy or client host — only the host that builds and pushes
# images needs them.
HYQS_REGISTRY_PUSH_ENABLED=
HYQS_REGISTRY_DOMAIN=
HYQS_REGISTRY_PUSH_USER=
HYQS_REGISTRY_PUSH_PASS=
HYQS_COSIGN_KEY_PATH=
HYQS_COSIGN_KEY_PASSWORD=

# Pull/verify credentials for hyqs/pipeline/registry_push.py's pull-by-digest
# apply path (Epic 81 promotion deploys). DEPLOY/CLIENT-HOST-ONLY: these carry
# a pull-only credential and a cosign PUBLIC verify key, so they must never be
# set on a build host — only a host that applies pre-built, pre-signed release
# images needs them.
HYQS_REGISTRY_PULL_ENABLED=
HYQS_REGISTRY_PULL_USER=
HYQS_REGISTRY_PULL_PASS=
HYQS_COSIGN_PUBLIC_KEY_PATH=

# --- MCP OAuth (RFC 9728 + RFC 7591 via FastMCP OAuthProxy / Google OIDC) ---
# Full public URL of the MCP endpoint — used to compute OAuth discovery paths.
# Must add /mcp/auth/callback to Google Console's authorized redirect URIs.
HYQS_MCP_RESOURCE_URL=https://hyqs.example.com/mcp
# Google OAuth credentials are shared with the web SSO (HYQS_GOOGLE_CLIENT_ID /
# HYQS_GOOGLE_CLIENT_SECRET already set above).
