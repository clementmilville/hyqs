{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/registry"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "failDelay": 1
    },
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {
              "users": ["push"],
              "actions": ["create", "read", "update", "delete"]
            },
            {
              "users": ["pull"],
              "actions": ["read"]
            }
          ],
          "defaultPolicy": []
        }
      },
      "adminPolicy": {
        "users": [],
        "actions": []
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    }
  }
}
